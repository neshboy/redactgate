{
  "name": "redactgate",
  "version": "0.1.0",
  "description": "A local HTTP(S) proxy that redacts secrets and PII from outgoing LLM API requests before they leave your machine.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "redactgate": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "proxy",
    "secrets",
    "redaction",
    "security",
    "llm",
    "privacy",
    "gitleaks",
    "detect-secrets"
  ],
  "dependencies": {
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^5.0.1"
  }
}
